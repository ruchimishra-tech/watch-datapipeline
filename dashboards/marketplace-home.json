{
  "uid": "marketplace-home",
  "title": "Data Marketplace — Observability Platform",
  "description": "Control plane homepage: global health, portfolio tiles, product catalog drill-down, health heatmap, and active incidents. RBAC-ready.",
  "tags": ["marketplace", "home", "observability", "control-plane"],
  "schemaVersion": 38,
  "version": 4,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},

  "templating": {
    "list": [
      {
        "name": "environment",
        "label": "Environment",
        "type": "custom",
        "query": "docker-dev,dev,test,prod",
        "options": [
          { "text": "docker-dev", "value": "docker-dev", "selected": true },
          { "text": "dev",        "value": "dev",        "selected": false },
          { "text": "test",       "value": "test",       "selected": false },
          { "text": "prod",       "value": "prod",       "selected": false }
        ],
        "current": { "text": "docker-dev", "value": "docker-dev" },
        "includeAll": false,
        "multi": false,
        "hide": 0
      },
      {
        "name": "portfolio",
        "label": "Portfolio",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus-dev" },
        "query": "query_result(group by (portfolio) (data_product_health_score{environment=\"$environment\"}))",
        "definition": "query_result(group by (portfolio) (data_product_health_score{environment=\"$environment\"}))",
        "regex": "/.*portfolio=\"([^\"]+)\".*/",
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "hide": 0,
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "name": "domain",
        "label": "Domain",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus-dev" },
        "query": "query_result(group by (domain) (data_product_health_score{environment=\"$environment\",portfolio=~\"$portfolio\"}))",
        "definition": "query_result(group by (domain) (data_product_health_score{environment=\"$environment\",portfolio=~\"$portfolio\"}))",
        "regex": "/.*domain=\"([^\"]+)\".*/",
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "hide": 0,
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "name": "product",
        "label": "Product",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus-dev" },
        "query": "query_result(group by (product) (data_product_health_score{environment=\"$environment\",portfolio=~\"$portfolio\",domain=~\"$domain\"}))",
        "definition": "query_result(group by (product) (data_product_health_score{environment=\"$environment\",portfolio=~\"$portfolio\",domain=~\"$domain\"}))",
        "regex": "/.*product=\"([^\"]+)\".*/",
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "hide": 0,
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "name": "owner",
        "label": "Owner",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus-dev" },
        "query": "query_result(group by (owner) (data_product_health_score{environment=\"$environment\",portfolio=~\"$portfolio\"}))",
        "definition": "query_result(group by (owner) (data_product_health_score{environment=\"$environment\",portfolio=~\"$portfolio\"}))",
        "regex": "/.*owner=\"([^\"]+)\".*/",
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "hide": 0,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },

  "panels": [

    {
      "id": 1,
      "type": "text",
      "title": "",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 3 },
      "transparent": true,
      "options": {
        "mode": "markdown",
        "content": "# Data Marketplace &nbsp;·&nbsp; Observability Platform\n\nReal-time health across all data products &mdash; **SLA compliance** &nbsp;·&nbsp; **freshness** &nbsp;·&nbsp; **availability** &nbsp;·&nbsp; **active incidents**.\n\nFilter by **Environment · Portfolio · Domain · Owner** above &nbsp;·&nbsp; Drill down: click any portfolio or product name &nbsp;·&nbsp; Red = action needed now."
      }
    },

    {
      "id": 2,
      "uid": "mp-kpi-total",
      "title": "Total Data Products",
      "description": "Count of registered data products matching current filters.",
      "type": "stat",
      "gridPos": { "x": 0, "y": 3, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus-dev" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "blue", "value": null }
          ]}
        }
      },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "prometheus-dev" },
        "expr": "count(group by (portfolio, domain, product) (data_product_health_score{portfolio=~\"$portfolio\",domain=~\"$domain\",product=~\"$product\",environment=\"$environment\"}))",
        "legendFormat": "Products",
        "refId": "A",
        "instant": true
      }]
    },

    {
      "id": 3,
      "uid": "mp-kpi-healthy",
      "title": "Healthy",
      "description": "Products with health score ≥ 95%.",
      "type": "stat",
      "gridPos": { "x": 4, "y": 3, "w": 3, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus-dev" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null }
          ]}
        }
      },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "prometheus-dev" },
        "expr": "count(data_product_health_score{portfolio=~\"$portfolio\",domain=~\"$domain\",product=~\"$product\",environment=\"$environment\"} >= 0.95) or vector(0)",
        "legendFormat": "Healthy",
        "refId": "A",
        "instant": true
      }]
    },

    {
      "id": 4,
      "uid": "mp-kpi-degraded",
      "title": "Degraded",
      "description": "Products with health score between 75% and 95% — watch closely.",
      "type": "stat",
      "gridPos": { "x": 7, "y": 3, "w": 3, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus-dev" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green",  "value": null },
            { "color": "yellow", "value": 1 }
          ]}
        }
      },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "prometheus-dev" },
        "expr": "count(data_product_health_score{portfolio=~\"$portfolio\",domain=~\"$domain\",product=~\"$product\",environment=\"$environment\"} >= 0.75 < 0.95) or vector(0)",
        "legendFormat": "Degraded",
        "refId": "A",
        "instant": true
      }]
    },

    {
      "id": 5,
      "uid": "mp-kpi-failed",
      "title": "Failed",
      "description": "Products with health score below 75% — immediate attention required.",
      "type": "stat",
      "gridPos": { "x": 10, "y": 3, "w": 3, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus-dev" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green",  "value": null },
            { "color": "yellow", "value": 1 },
            { "color": "red",    "value": 3 }
          ]}
        }
      },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "prometheus-dev" },
        "expr": "count(data_product_health_score{portfolio=~\"$portfolio\",domain=~\"$domain\",product=~\"$product\",environment=\"$environment\"} < 0.75) or vector(0)",
        "legendFormat": "Failed",
        "refId": "A",
        "instant": true
      }]
    },

    {
      "id": 6,
      "uid": "mp-kpi-slo",
      "title": "SLO Compliance",
      "description": "Average SLO compliance ratio across all filtered data products.",
      "type": "stat",
      "gridPos": { "x": 13, "y": 3, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus-dev" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red",    "value": null },
            { "color": "yellow", "value": 0.95 },
            { "color": "green",  "value": 0.99 }
          ]}
        }
      },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "prometheus-dev" },
        "expr": "avg(data_product_slo_compliance_ratio{portfolio=~\"$portfolio\",domain=~\"$domain\",product=~\"$product\",environment=\"$environment\"})",
        "legendFormat": "SLO",
        "refId": "A",
        "instant": true
      }]
    },

    {
      "id": 7,
      "uid": "mp-kpi-incidents",
      "title": "Active Incidents",
      "description": "Products currently below healthy threshold (health score < 75%).",
      "type": "stat",
      "gridPos": { "x": 17, "y": 3, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus-dev" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green",  "value": null },
            { "color": "yellow", "value": 1 },
            { "color": "red",    "value": 3 }
          ]}
        }
      },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "prometheus-dev" },
        "expr": "count(data_product_health_score{portfolio=~\"$portfolio\",domain=~\"$domain\",product=~\"$product\",environment=\"$environment\"} < 0.75) or vector(0)",
        "legendFormat": "Incidents",
        "refId": "A",
        "instant": true
      }]
    },

    {
      "id": 8,
      "uid": "mp-kpi-freshness",
      "title": "Freshness Breaches",
      "description": "Products whose data freshness exceeds 1 hour.",
      "type": "stat",
      "gridPos": { "x": 21, "y": 3, "w": 3, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus-dev" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green",  "value": null },
            { "color": "yellow", "value": 1 },
            { "color": "red",    "value": 3 }
          ]}
        }
      },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "prometheus-dev" },
        "expr": "count(data_product_freshness_seconds{portfolio=~\"$portfolio\",domain=~\"$domain\",product=~\"$product\",environment=\"$environment\"} > 3600) or vector(0)",
        "legendFormat": "Breaches",
        "refId": "A",
        "instant": true
      }]
    },

    {
      "id": 100,
      "type": "row",
      "title": "PORTFOLIO OVERVIEW",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 7, "w": 24, "h": 1 }
    },

    {
      "id": 10,
      "uid": "mp-portfolio-table",
      "title": "Portfolio Health Summary",
      "description": "One row per portfolio. Average health score, product count, SLO compliance and products in incident. Click the portfolio name to filter the rest of the dashboard.",
      "type": "table",
      "gridPos": { "x": 0, "y": 8, "w": 14, "h": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus-dev" },
      "options": {
        "footer": { "show": false },
        "showHeader": true,
        "cellHeight": "md",
        "sortBy": [{ "displayName": "Health Score", "desc": false }]
      },
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto" } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "portfolio" },
            "properties": [
              { "id": "displayName", "value": "Portfolio" },
              { "id": "custom.width", "value": 200 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Value #A" },
            "properties": [
              { "id": "displayName", "value": "Health Score" },
              { "id": "unit", "value": "percentunit" },
              { "id": "decimals", "value": 2 },
              { "id": "custom.width", "value": 130 },
              { "id": "custom.cellOptions", "value": { "type": "color-background", "mode": "basic" } },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [
                { "color": "red", "value": null },
                { "color": "yellow", "value": 0.75 },
                { "color": "green", "value": 0.95 }
              ]}}
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Value #B" },
            "properties": [
              { "id": "displayName", "value": "Products" },
              { "id": "unit", "value": "short" },
              { "id": "decimals", "value": 0 },
              { "id": "custom.width", "value": 90 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Value #C" },
            "properties": [
              { "id": "displayName", "value": "Failed Products" },
              { "id": "unit", "value": "short" },
              { "id": "decimals", "value": 0 },
              { "id": "custom.width", "value": 120 },
              { "id": "custom.cellOptions", "value": { "type": "color-background", "mode": "basic" } },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 1 },
                { "color": "red", "value": 2 }
              ]}}
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Value #D" },
            "properties": [
              { "id": "displayName", "value": "SLO %" },
              { "id": "unit", "value": "percentunit" },
              { "id": "decimals", "value": 2 },
              { "id": "custom.width", "value": 110 },
              { "id": "custom.cellOptions", "value": { "type": "color-background", "mode": "basic" } },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [
                { "color": "red", "value": null },
                { "color": "yellow", "value": 0.95 },
                { "color": "green", "value": 0.99 }
              ]}}
            ]
          }
        ]
      },
      "transformations": [
        { "id": "joinByField", "options": { "byField": "portfolio", "mode": "outer" } },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true, "Time 1": true, "Time 2": true, "Time 3": true,
              "environment": true, "instance": true, "job": true
            },
            "renameByName": {},
            "indexByName": {
              "portfolio": 0, "Value #A": 1, "Value #B": 2, "Value #C": 3, "Value #D": 4
            }
          }
        }
      ],
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus-dev" },
          "expr": "avg by (portfolio) (data_product_health_score{portfolio=~\"$portfolio\",environment=\"$environment\",owner=~\"$owner\"})",
          "legendFormat": "{{portfolio}}",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus-dev" },
          "expr": "count by (portfolio) (group by (portfolio, product) (data_product_health_score{portfolio=~\"$portfolio\",environment=\"$environment\",owner=~\"$owner\"}))",
          "legendFormat": "{{portfolio}}",
          "refId": "B",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus-dev" },
          "expr": "sum by (portfolio) (data_product_health_score{portfolio=~\"$portfolio\",environment=\"$environment\",owner=~\"$owner\"} < bool 0.75)",
          "legendFormat": "{{portfolio}}",
          "refId": "C",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus-dev" },
          "expr": "avg by (portfolio) (data_product_slo_compliance_ratio{portfolio=~\"$portfolio\",environment=\"$environment\",owner=~\"$owner\"})",
          "legendFormat": "{{portfolio}}",
          "refId": "D",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ]
    },

    {
      "id": 11,
      "uid": "mp-portfolio-gauge",
      "title": "Health Score by Portfolio",
      "description": "Average health score per portfolio. Green ≥ 95% · Yellow ≥ 75% · Red < 75%.",
      "type": "bargauge",
      "gridPos": { "x": 14, "y": 8, "w": 10, "h": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus-dev" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "valueMode": "color",
        "showUnfilled": true,
        "minVizWidth": 0,
        "minVizHeight": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "min": 0,
          "max": 1,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red",    "value": null },
            { "color": "yellow", "value": 0.75 },
            { "color": "green",  "value": 0.95 }
          ]}
        }
      },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "prometheus-dev" },
        "expr": "avg by (portfolio) (data_product_health_score{portfolio=~\"$portfolio\",environment=\"$environment\",owner=~\"$owner\"})",
        "legendFormat": "{{portfolio}}",
        "refId": "A",
        "instant": true,
        "range": false
      }]
    },

    {
      "id": 101,
      "type": "row",
      "title": "DATA PRODUCT CATALOG",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 17, "w": 24, "h": 1 }
    },

    {
      "id": 12,
      "uid": "mp-catalog-table",
      "title": "Data Product Catalog — worst health first",
      "description": "Full product registry scoped to current filters. Red rows need immediate attention.",
      "type": "table",
      "gridPos": { "x": 0, "y": 18, "w": 24, "h": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus-dev" },
      "options": {
        "footer": { "show": false },
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [{ "displayName": "Health Score", "desc": false }]
      },
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto", "filterable": true } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "product" },
            "properties": [
              { "id": "displayName", "value": "Product" },
              { "id": "custom.width", "value": 220 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "portfolio" },
            "properties": [
              { "id": "displayName", "value": "Portfolio" },
              { "id": "custom.width", "value": 180 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "domain" },
            "properties": [
              { "id": "displayName", "value": "Domain" },
              { "id": "custom.width", "value": 160 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "owner" },
            "properties": [
              { "id": "displayName", "value": "Owner" },
              { "id": "custom.width", "value": 170 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Value #A" },
            "properties": [
              { "id": "displayName", "value": "Health Score" },
              { "id": "unit", "value": "percentunit" },
              { "id": "decimals", "value": 2 },
              { "id": "custom.width", "value": 130 },
              { "id": "custom.cellOptions", "value": { "type": "color-background", "mode": "basic" } },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [
                { "color": "red", "value": null },
                { "color": "yellow", "value": 0.75 },
                { "color": "green", "value": 0.95 }
              ]}}
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Value #B" },
            "properties": [
              { "id": "displayName", "value": "SLO Compliance" },
              { "id": "unit", "value": "percentunit" },
              { "id": "decimals", "value": 2 },
              { "id": "custom.width", "value": 140 },
              { "id": "custom.cellOptions", "value": { "type": "color-background", "mode": "basic" } },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [
                { "color": "red", "value": null },
                { "color": "yellow", "value": 0.95 },
                { "color": "green", "value": 0.99 }
              ]}}
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Value #C" },
            "properties": [
              { "id": "displayName", "value": "Freshness" },
              { "id": "unit", "value": "dtdurations" },
              { "id": "decimals", "value": 0 },
              { "id": "custom.width", "value": 150 },
              { "id": "custom.cellOptions", "value": { "type": "color-background", "mode": "basic" } },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [
                { "color": "green",  "value": null },
                { "color": "yellow", "value": 3600 },
                { "color": "red",    "value": 86400 }
              ]}}
            ]
          }
        ]
      },
      "transformations": [
        { "id": "joinByField", "options": { "byField": "product", "mode": "outer" } },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true, "Time 1": true, "Time 2": true,
              "environment": true, "environment 1": true, "environment 2": true,
              "instance": true, "job": true,
              "portfolio 1": true, "portfolio 2": true,
              "domain 1": true, "domain 2": true,
              "owner 1": true, "owner 2": true
            },
            "renameByName": {},
