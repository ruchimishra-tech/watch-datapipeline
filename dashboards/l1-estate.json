{
  "__watch_meta": {
    "tier": "L1",
    "mandatory_panels": ["pipeline-success-rate", "total-runs-today", "failed-runs-1h", "pipeline-run-table"],
    "required_variables": ["environment"]
  },
  "uid": "watch-l1-estate",
  "title": "Watch — Pipeline Estate Health",
  "description": "L1 dashboard: overall pipeline estate health. Use this as the starting point for incident investigation.",
  "tags": ["watch", "l1", "estate"],
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-24h", "to": "now" },
  "timepicker": {},
  "templating": {
    "list": [
      {
        "name": "environment",
        "label": "Environment",
        "type": "custom",
        "options": [
          { "text": "dev",        "value": "dev",        "selected": true },
          { "text": "staging",    "value": "staging",    "selected": false },
          { "text": "production", "value": "production", "selected": false }
        ],
        "current": { "text": "dev", "value": "dev" },
        "hide": 0,
        "includeAll": false,
        "multi": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "uid": "pipeline-success-rate",
      "title": "Pipeline Success Rate (24h)",
      "description": "Percentage of pipeline runs that completed successfully in the last 24 hours. Target: >99%.",
      "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus-dev" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red",    "value": null },
              { "color": "yellow", "value": 0.95 },
              { "color": "green",  "value": 0.99 }
            ]
          }
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus-dev" },
          "expr": "sum(rate(pipeline_runs_total{status=\"success\", environment=\"$environment\"}[24h])) / sum(rate(pipeline_runs_total{environment=\"$environment\"}[24h]))",
          "legendFormat": "Success Rate",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "uid": "total-runs-today",
      "title": "Total Pipeline Runs Today",
      "description": "Total number of pipeline run completions in the last 24 hours.",
      "type": "stat",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus-dev" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "blue", "value": null }]
          }
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus-dev" },
          "expr": "sum(increase(pipeline_runs_total{environment=\"$environment\"}[24h]))",
          "legendFormat": "Runs",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "uid": "failed-runs-1h",
      "title": "Failed Runs (Last 1h)",
      "description": "Number of pipeline failures in the last hour. Non-zero warrants investigation.",
      "type": "stat",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus-dev" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red",    "value": 3 }
            ]
          }
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus-dev" },
          "expr": "sum(increase(pipeline_runs_total{status=\"failed\", environment=\"$environment\"}[1h]))",
          "legendFormat": "Failures",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "uid": "avg-run-duration",
      "title": "Avg Run Duration (24h)",
      "description": "Average pipeline run duration across all pipelines.",
      "type": "stat",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus-dev" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value"
      },
      "fieldConfig": {
        "defaults": { "unit": "ms" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus-dev" },
          "expr": "avg(pipeline_run_duration_ms{environment=\"$environment\"})",
          "legendFormat": "Avg Duration",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "uid": "pipeline-run-table",
      "title": "Pipeline Runs",
      "description": "All pipeline runs in the selected time range. Click a row to open the L2 run detail dashboard.",
      "type": "table",
      "gridPos": { "x": 0, "y": 4, "w": 24, "h": 12 },
      "datasource": { "type": "tempo", "uid": "tempo-dev" },
      "options": {
        "footer": { "show": false },
        "sortBy": [{ "displayName": "Start Time", "desc": true }]
      },
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto" } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "pipeline.status" },
            "properties": [
              {
                "id": "custom.displayMode",
                "value": "color-background"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green", "value": null }
                  ]
                }
              },
              {
                "id": "mappings",
                "value": [
                  { "type": "value", "options": { "success":  { "color": "green",  "text": "success"  } } },
                  { "type": "value", "options": { "failed":   { "color": "red",    "text": "failed"   } } },
                  { "type": "value", "options": { "running":  { "color": "blue",   "text": "running"  } } },
                  { "type": "value", "options": { "cancelled":{ "color": "grey",   "text": "cancelled"} } }
                ]
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "datasource": { "type": "tempo", "uid": "tempo-dev" },
          "queryType": "traceql",
          "query": "{span.deployment.environment=\"$environment\" && name=\"pipeline.run\"}",
          "refId": "A",
          "tableType": "spans",
          "limit": 100
        }
      ]
    },
    {
      "id": 6,
      "uid": "success-rate-trend",
      "title": "Success Rate Trend",
      "description": "Pipeline success rate over the selected time range.",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus-dev" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0, "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red",    "value": null },
              { "color": "yellow", "value": 0.95 },
              { "color": "green",  "value": 0.99 }
            ]
          }
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus-dev" },
          "expr": "sum by (pipeline_id) (rate(pipeline_runs_total{status=\"success\", environment=\"$environment\"}[1h])) / sum by (pipeline_id) (rate(pipeline_runs_total{environment=\"$environment\"}[1h]))",
          "legendFormat": "{{pipeline_id}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "uid": "job-latency-trend",
      "title": "Pipeline Run Duration (p95)",
      "description": "95th percentile run duration per pipeline over time.",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus-dev" },
      "fieldConfig": {
        "defaults": { "unit": "ms" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus-dev" },
          "expr": "histogram_quantile(0.95, sum by (pipeline_id, le) (rate(pipeline_run_duration_ms_bucket{environment=\"$environment\"}[1h])))",
          "legendFormat": "{{pipeline_id}} p95",
          "refId": "A"
        }
      ]
    }
  ]
}
