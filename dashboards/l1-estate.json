{
  "__watch_meta": {
    "tier": "L1",
    "mandatory_panels": [
      "pipeline-success-rate",
      "total-runs-today",
      "failed-runs-1h",
      "pipeline-catalog",
      "pipeline-run-table"
    ],
    "required_variables": [
      "environment"
    ]
  },
  "uid": "watch-l1-estate",
  "title": "L1 \u2014 Estate Health",
  "description": "L1 dashboard: overall pipeline estate health. Starting point for incident investigation. Drill down: click any traceID \u2192 L2 Run Detail. See infra panel for L3 Infrastructure.",
  "tags": [
    "watch",
    "l1",
    "estate"
  ],
  "schemaVersion": 38,
  "version": 5,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {},
  "templating": {
    "list": [
      {
        "name": "environment",
        "label": "Environment",
        "type": "custom",
        "options": [
          {
            "text": "docker-dev",
            "value": "docker-dev",
            "selected": true
          },
          {
            "text": "dev",
            "value": "dev",
            "selected": false
          },
          {
            "text": "staging",
            "value": "staging",
            "selected": false
          },
          {
            "text": "production",
            "value": "production",
            "selected": false
          }
        ],
        "current": {
          "text": "docker-dev",
          "value": "docker-dev"
        },
        "hide": 0,
        "includeAll": false,
        "multi": false
      }
    ]
  },
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "ESTATE SUMMARY",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 1,
      "uid": "active-pipelines",
      "title": "Active Pipelines",
      "description": "Total distinct pipelines currently emitting telemetry.",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-dev"
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-dev"
          },
          "expr": "count(count by (pipeline_id) (simulator_pipeline_info{environment=\"$environment\"}))",
          "legendFormat": "Pipelines",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "id": 2,
      "uid": "pipeline-success-rate",
      "title": "Success Rate (24h)",
      "description": "Percentage of all pipeline runs that completed successfully in the last 24 hours. Target: >99%.",
      "type": "stat",
      "gridPos": {
        "x": 4,
        "y": 1,
        "w": 5,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-dev"
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.9
              },
              {
                "color": "green",
                "value": 0.99
              }
            ]
          }
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-dev"
          },
          "expr": "sum(rate(simulator_pipeline_runs_total{status=\"success\", environment=\"$environment\"}[24h])) / sum(rate(simulator_pipeline_runs_total{environment=\"$environment\"}[24h]))",
          "legendFormat": "Success Rate",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "uid": "failed-runs-1h",
      "title": "Failed Runs (1h)",
      "description": "Number of pipeline failures in the last hour. Any non-zero value warrants investigation \u2014 drill into L2.",
      "type": "stat",
      "gridPos": {
        "x": 9,
        "y": 1,
        "w": 5,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-dev"
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 3
              }
            ]
          }
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-dev"
          },
          "expr": "sum(increase(simulator_pipeline_runs_total{status=\"failed\", environment=\"$environment\"}[1h]))",
          "legendFormat": "Failures",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "uid": "sla-breaches-today",
      "title": "SLA Breaches (24h)",
      "description": "Runs that exceeded their declared SLA duration. slow-etl consistently breaches its 60s SLA.",
      "type": "stat",
      "gridPos": {
        "x": 14,
        "y": 1,
        "w": 5,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-dev"
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-dev"
          },
          "expr": "sum(increase(simulator_sla_breaches_total{environment=\"$environment\"}[24h]))",
          "legendFormat": "SLA Breaches",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "uid": "dq-violations-today",
      "title": "DQ Violations (24h)",
      "description": "Data quality check violations. raw-ingestion has 15% chance of a user_id null spike per run.",
      "type": "stat",
      "gridPos": {
        "x": 19,
        "y": 1,
        "w": 5,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-dev"
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-dev"
          },
          "expr": "sum(increase(simulator_dq_violations_total{environment=\"$environment\"}[24h]))",
          "legendFormat": "DQ Violations",
          "refId": "A"
        }
      ]
    },
    {
      "id": 101,
      "type": "row",
      "title": "PIPELINE CATALOG \u2014 one row per pipeline, click traceID below to drill into a run",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 6,
      "uid": "pipeline-catalog",
      "title": "Pipeline Registry",
      "description": "One row per pipeline. Shows name, domain, owner, scenario description, 24h success rate, last run duration, SLA breaches and DQ violations. Click a pipeline_id to filter the runs table below.",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 24,
        "h": 11
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-dev"
      },
      "options": {
        "footer": {
          "show": false
        },
        "sortBy": [
          {
            "displayName": "Pipeline Name",
            "desc": false
          }
        ],
        "frameIndex": 0,
        "showHeader": true,
        "cellHeight": "md"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true
          },
          "noValue": "\u2014"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "pipeline_name"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Pipeline Name"
              },
              {
                "id": "custom.width",
                "value": 210
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "auto"
                }
              },
              {
                "id": "links",
                "value": [
                  {
                    "title": "View all runs for this pipeline \u2192",
                    "url": "/d/watch-l2-pipeline?var-environment=${environment}&var-pipeline_id=${__data.fields.pipeline_id.value}",
                    "targetBlank": false
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "pipeline_id"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Pipeline ID"
              },
              {
                "id": "custom.width",
                "value": 220
              },
              {
                "id": "links",
                "value": [
                  {
                    "title": "View all runs for this pipeline \u2192",
                    "url": "/d/watch-l2-pipeline?var-environment=${environment}&var-pipeline_id=${__value.raw}",
                    "targetBlank": false
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "domain"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Domain"
              },
              {
                "id": "custom.width",
                "value": 130
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "customer-data": {
                        "color": "blue",
                        "text": "customer-data",
                        "index": 0
                      }
                    }
                  },
                  {
                    "type": "value",
                    "options": {
                      "risk": {
                        "color": "orange",
                        "text": "risk",
                        "index": 1
                      }
                    }
                  },
                  {
                    "type": "value",
                    "options": {
                      "data-platform": {
                        "color": "purple",
                        "text": "data-platform",
                        "index": 2
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "owner"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Owner"
              },
              {
                "id": "custom.width",
                "value": 170
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "description"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Scenario / Description"
              },
              {
                "id": "custom.width",
                "value": 290
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Success Rate"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "custom.width",
                "value": 110
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": 0.75
                    },
                    {
                      "color": "green",
                      "value": 0.95
                    }
                  ]
                }
              },
              {
                "id": "noValue",
                "value": "\u2014"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Last Duration"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "custom.width",
                "value": 120
              },
              {
                "id": "noValue",
                "value": "\u2014"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "SLA Breaches"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 110
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": 1
                    },
                    {
                      "color": "red",
                      "value": 5
                    }
                  ]
                }
              },
              {
                "id": "noValue",
                "value": "0"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "DQ Violations"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 110
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": 1
                    },
                    {
                      "color": "red",
                      "value": 3
                    }
                  ]
                }
              },
              {
                "id": "noValue",
                "value": "0"
              }
            ]
          }
        ]
      },
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "pipeline_id",
            "mode": "outer"
          }
        },
        {
          "id": "calculateField",
          "options": {
            "alias": "Success Rate",
            "mode": "binaryOperation",
            "binary": {
              "left": "Value #success",
              "right": "Value #total",
              "operator": "/"
            },
            "reduce": {
              "reducer": "sum"
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "Time 4": true,
              "Time 5": true,
              "__name__": true,
              "environment": true,
              "instance": true,
              "instance 1": true,
              "instance 2": true,
              "job": true,
              "job 1": true,
              "job 2": true,
              "Value #info": true,
              "Value #duration": true
            },
            "renameByName": {
              "Value #success": "Successes (24h)",
              "Value #total": "Total Runs (24h)",
              "Value #sla": "SLA Breaches",
              "Value #dq": "DQ Violations",
              "simulator_pipeline_last_duration_seconds": "Last Duration"
            },
            "indexByName": {
              "pipeline_name": 0,
              "pipeline_id": 1,
              "domain": 2,
              "owner": 3,
              "description": 4,
              "Success Rate": 5,
              "Last Duration": 6,
              "SLA Breaches": 7,
              "DQ Violations": 8
            }
          }
        }
      ],
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-dev"
          },
          "expr": "simulator_pipeline_info{environment=\"$environment\"}",
          "instant": true,
          "legendFormat": "",
          "refId": "info",
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-dev"
          },
          "expr": "sum by (pipeline_id) (increase(simulator_pipeline_runs_total{status=\"success\", environment=\"$environment\"}[24h]))",
          "instant": true,
          "legendFormat": "",
          "refId": "success",
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-dev"
          },
          "expr": "sum by (pipeline_id) (increase(simulator_pipeline_runs_total{environment=\"$environment\"}[24h]))",
          "instant": true,
          "legendFormat": "",
          "refId": "total",
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-dev"
          },
          "expr": "simulator_pipeline_last_duration_seconds{environment=\"$environment\"}",
          "instant": true,
          "legendFormat": "",
          "refId": "duration",
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-dev"
          },
          "expr": "sum by (pipeline_id) (increase(simulator_sla_breaches_total{environment=\"$environment\"}[24h]))",
          "instant": true,
          "legendFormat": "",
          "refId": "sla",
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-dev"
          },
          "expr": "sum by (pipeline_id) (increase(simulator_dq_violations_total{environment=\"$environment\"}[24h]))",
          "instant": true,
          "legendFormat": "",
          "refId": "dq",
          "format": "table"
        }
      ]
    },
    {
      "id": 102,
      "type": "row",
      "title": "PERFORMANCE TRENDS",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 7,
      "uid": "success-rate-trend",
      "title": "Success Rate by Pipeline (1h window)",
      "description": "Pipeline success rate over time. risk-scoring should show ~75%, others ~100%.",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-dev"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.9
              },
              {
                "color": "green",
                "value": 0.99
              }
            ]
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "min"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-dev"
          },
          "expr": "sum by (pipeline_id) (rate(simulator_pipeline_runs_total{status=\"success\", environment=\"$environment\"}[1h])) / sum by (pipeline_id) (rate(simulator_pipeline_runs_total{environment=\"$environment\"}[1h]))",
          "legendFormat": "{{pipeline_id}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "uid": "job-latency-trend",
      "title": "Last Run Duration by Pipeline",
      "description": "Most recent run duration per pipeline. slow-etl will regularly exceed the 60s SLA line.",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-dev"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 60
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-dev"
          },
          "expr": "simulator_pipeline_last_duration_seconds{environment=\"$environment\"}",
          "legendFormat": "{{pipeline_id}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 103,
      "type": "row",
      "title": "RECENT PIPELINE RUNS \u2014 Click any traceID to open L2 Pipeline Run Detail",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 9,
      "uid": "pipeline-run-table",
      "title": "Pipeline Runs \u2014 click Pipeline to drill down, click Trace ID for direct trace",
